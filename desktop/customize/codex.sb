(version 1)
; rach3 starts Codex inside this sandbox. macOS enforces it, not Codex, so it binds
; Codex itself and everything Codex starts. Codex may read the system's own files,
; its program, its home and the scratch copy it edits, and write only the last two.
; The person's files (the rest of /Users, other disks, shared temporary folders) are
; out of reach. Only Codex itself reaches the network; the commands it runs do not.
; macOS allows no sandbox inside a sandbox, so Codex runs with its own sandbox off.
; Parameters: CODEX (the bundled package), HOME (Codex's home, which holds its
; temporary folder) and WORKSPACE (the scratch copy).

(allow default)
(deny file-read* file-write*)

; What programs need to start and run: macOS itself, its tools and settings.
(allow file-read*
  (literal "/")
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/Library/Apple")
  (subpath "/Library/Preferences")
  (subpath "/Library/Keychains")
  (subpath "/private/etc")
  (subpath "/private/var/db/timezone")
  (subpath "/private/var/db/dyld")
  (literal "/private/var/db/DarwinDirectory/local/recordStore.data")
  (literal "/private/var/select/sh"))
; Names only, so paths through these folders resolve; their contents stay closed.
(allow file-read-metadata
  (literal "/etc") (literal "/tmp") (literal "/var") (literal "/private")
  (literal "/private/var") (literal "/Users") (literal "/Applications")
  (literal "/Library") (literal "/Library/Application Support")
  (path-ancestors (param "HOME")) (path-ancestors (param "WORKSPACE")))

; Terminals and the usual devices.
(allow file-read* file-write*
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/tty")
  (literal "/dev/ptmx") (regex #"^/dev/ttys[0-9]+$") (subpath "/dev/fd"))
(allow file-read* (literal "/dev/random") (literal "/dev/urandom") (literal "/dev/autofs_nowait"))
(allow file-ioctl (literal "/dev/ptmx") (regex #"^/dev/ttys[0-9]+$") (literal "/dev/tty"))

; Codex's own program, home and scratch copy.
(allow file-read* (subpath (param "CODEX")))
(allow file-read* file-write* (subpath (param "HOME")) (subpath (param "WORKSPACE")))

; Codex talks to ChatGPT; a command it runs gets no network.
(deny network-outbound
  (require-all (remote ip) (require-not (process-path (string-append (param "CODEX") "/bin/codex")))))
